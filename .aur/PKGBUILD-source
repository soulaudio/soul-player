pkgname=soul-player
pkgver=0.1.1
pkgrel=1
pkgdesc="Modern, privacy-first music player for local audio files"
arch=('x86_64')
url="https://github.com/soulaudio/soul-player"
license=('AGPL3')
depends=('gtk3' 'webkit2gtk' 'libayatana-appindicator' 'alsa-lib')
makedepends=('rust' 'cargo' 'nodejs' 'yarn' 'pkg-config')
provides=('soul-player')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/soulaudio/soul-player/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # Update with actual SHA256 after first release

build() {
    cd "${pkgname}-${pkgver}"

    # Enable Corepack for Yarn 4
    corepack enable

    # Install dependencies
    yarn install

    # Build frontend
    cd applications/desktop
    yarn build

    # Build Tauri app
    cd ../..
    cargo build --release --package soul-player-desktop
}

package() {
    cd "${pkgname}-${pkgver}"

    # Install binary
    install -Dm755 "target/release/soul-player" "${pkgdir}/usr/bin/soul-player"

    # Install desktop file
    install -Dm644 "applications/desktop/src-tauri/soul-player.desktop" \
        "${pkgdir}/usr/share/applications/soul-player.desktop"

    # Install icon
    for size in 32 128 256; do
        install -Dm644 "applications/desktop/src-tauri/icons/${size}x${size}.png" \
            "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/soul-player.png"
    done

    # Install license
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
