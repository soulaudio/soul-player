// ===== Queue Position Persistence Tests =====

#[tokio::test]
async fn test_persist_source_queue_index() {
    let mut manager = PlaybackManager::default();

    manager.load_playlist(
        vec![
            create_track("1", "Track 1", "Artist A", 180),
            create_track("2", "Track 2", "Artist B", 180),
            create_track("3", "Track 3", "Artist C", 180),
            create_track("4", "Track 4", "Artist D", 180),
        ],
        0,
    );

    // Play to track 3 (index 2)
    manager.next().ok();
    manager.next().ok();

    // Serialize
    let json = manager.to_persistence_json().expect("Should serialize");

    // Restore
    let mut manager2 = PlaybackManager::default();
    manager2.from_persistence_json(&json).expect("Should deserialize");

    let queue = manager2.get_queue();
    let ids: Vec<String> = queue.iter().map(|t| t.id.clone()).collect();

    // Should resume from track 3 position (remaining: track 4)
    assert_eq!(
        ids.len(),
        2,
        "Restored queue should have remaining tracks from position"
    );
    assert_eq!(ids[0], "3", "Should resume at track 3");
    assert_eq!(ids[1], "4", "Should have track 4 remaining");
}

// ===== Full State Persistence Tests =====

#[tokio::test]
async fn test_persist_complete_state() {
    let mut manager = PlaybackManager::default();

    // Set up complex state
    manager.set_repeat(RepeatMode::All);

    manager.load_playlist(
        vec![
            create_track("s1", "Source 1", "Artist A", 180),
            create_track("s2", "Source 2", "Artist B", 180),
            create_track("s3", "Source 3", "Artist C", 180),
        ],
        0,
    );

    manager.set_shuffle(ShuffleMode::Smart);
    manager.add_to_queue_next(create_track("n1", "Next 1", "Artist D", 180));
    manager.add_to_queue_end(create_track("q1", "Queue 1", "Artist E", 180));

    // Serialize
    let json = manager.to_persistence_json().expect("Should serialize");

    // Restore
    let mut manager2 = PlaybackManager::default();
    manager2.from_persistence_json(&json).expect("Should deserialize");

    // Verify all state restored
    assert_eq!(manager2.get_repeat_mode(), RepeatMode::All);
    assert_eq!(manager2.get_shuffle_mode(), ShuffleMode::Smart);

    let queue = manager2.get_queue();
    let ids: Vec<String> = queue.iter().map(|t| t.id.clone()).collect();

    // Should have all queues in correct priority
    assert!(
        ids.contains(&"n1".to_string()),
        "Play Next should be restored"
    );
    assert!(
        ids.contains(&"s1".to_string()) || ids.contains(&"s2".to_string()),
        "Source queue should be restored"
    );
    assert!(
        ids.contains(&"q1".to_string()),
        "Add to Queue should be restored"
    );
}

// ===== Error Handling Tests =====

#[tokio::test]
async fn test_deserialize_invalid_json() {
    let mut manager = PlaybackManager::default();

    let result = manager.from_persistence_json("invalid json");

    assert!(
        result.is_err(),
        "Should fail to deserialize invalid JSON"
    );
}

#[tokio::test]
async fn test_deserialize_empty_string() {
    let mut manager = PlaybackManager::default();

    let result = manager.from_persistence_json("");

    assert!(result.is_err(), "Should fail to deserialize empty string");
}

#[tokio::test]
async fn test_deserialize_partial_data() {
    let mut manager = PlaybackManager::default();

    // JSON with missing fields
    let json = r#"{"play_next": []}"#;

    // Should either fail gracefully or use defaults
    let result = manager.from_persistence_json(json);

    // Behavior depends on implementation choice:
    // - Strict: return error
    // - Lenient: use defaults for missing fields
}

// ===== Performance Tests =====

#[tokio::test]
async fn test_persist_large_queue() {
    let mut manager = PlaybackManager::default();

    // Large queue (1000 tracks)
    let tracks: Vec<QueueTrack> = (0..1000)
        .map(|i| create_track(&i.to_string(), &format!("Track {}", i), "Artist", 180))
        .collect();

    manager.load_playlist(tracks, 0);

    // Should serialize quickly
    let json = manager
        .to_persistence_json()
        .expect("Should serialize large queue");

    // Should deserialize quickly
    let mut manager2 = PlaybackManager::default();
    manager2
        .from_persistence_json(&json)
        .expect("Should deserialize large queue");

    assert_eq!(
        manager2.queue_len(),
        1000,
        "Restored queue should have all tracks"
    );
}

#[tokio::test]
async fn test_persist_queue_with_long_metadata() {
    let mut manager = PlaybackManager::default();

    // Track with very long metadata
    let long_title = "A".repeat(1000);
    let long_artist = "B".repeat(1000);

    manager.load_playlist(
        vec![create_track("1", &long_title, &long_artist, 180)],
        0,
    );

    let json = manager
        .to_persistence_json()
        .expect("Should serialize track with long metadata");

    let mut manager2 = PlaybackManager::default();
    manager2
        .from_persistence_json(&json)
        .expect("Should deserialize track with long metadata");

    let queue = manager2.get_queue();
    assert_eq!(queue[0].title, long_title);
    assert_eq!(queue[0].artist, long_artist);
}

// ===== Backwards Compatibility Tests =====

#[tokio::test]
async fn test_deserialize_legacy_two_tier_queue() {
    // Simulate old two-tier queue JSON format
    let legacy_json = r#"{
        "explicit": [
            {"id": "e1", "title": "Explicit 1", "artist": "Artist A"}
        ],
        "source": [
            {"id": "s1", "title": "Source 1", "artist": "Artist B"}
        ]
    }"#;

    let mut manager = PlaybackManager::default();

    // Should either migrate to three-tier or fail gracefully
    let result = manager.from_persistence_json(legacy_json);

    // Implementation choice:
    // - Migrate: Convert "explicit" to "play_next" or "add_to_queue"
    // - Fail: Return error for unsupported format
}
