//! Queue Persistence Tests
//!
//! Tests for saving and restoring queue state across app restarts.
//! Queue state includes:
//! - Three-tier queue structure (Play Next, Add to Queue, Source)
//! - Shuffle mode and original order
//! - Current position in source queue
//! - Repeat mode

use soul_playback::{PlaybackManager, QueueTrack, RepeatMode, ShuffleMode, TrackSource};
use std::path::PathBuf;
use std::time::Duration;

// ===== Test Helpers =====

fn create_track(id: &str, title: &str, artist: &str, duration_secs: u64) -> QueueTrack {
    QueueTrack {
        id: id.to_string(),
        path: PathBuf::from(format!("/music/{}.mp3", id)),
        title: title.to_string(),
        artist: artist.to_string(),
        album: Some("Test Album".to_string()),
        duration: Duration::from_secs(duration_secs),
        track_number: Some(id.parse().unwrap_or(1)),
        source: TrackSource::Single,
    }
}

// ===== Basic Persistence Tests =====

#[tokio::test]
async fn test_save_and_load_empty_queue() {
    let manager = PlaybackManager::default();

    // Serialize empty queue
    let json = manager
        .to_persistence_json()
        .expect("Should serialize empty queue");

    // Create new manager and restore
    let mut manager2 = PlaybackManager::default();
    manager2
        .from_persistence_json(&json)
        .expect("Should deserialize empty queue");

    assert_eq!(manager2.queue_len(), 0, "Restored queue should be empty");
}

#[tokio::test]
async fn test_save_and_load_simple_queue() {
    let mut manager = PlaybackManager::default();

    // Add tracks
    manager.load_playlist(
        vec![
            create_track("1", "Track 1", "Artist A", 180),
            create_track("2", "Track 2", "Artist B", 180),
            create_track("3", "Track 3", "Artist C", 180),
        ],
        0,
    );

    // Serialize
    let json = manager
        .to_persistence_json()
        .expect("Should serialize queue");

    // Create new manager and restore
    let mut manager2 = PlaybackManager::default();
    manager2
        .from_persistence_json(&json)
        .expect("Should deserialize queue");

    assert_eq!(manager2.queue_len(), 3, "Restored queue should have 3 tracks");

    let queue = manager2.get_queue();
    assert_eq!(queue[0].id, "1");
    assert_eq!(queue[1].id, "2");
    assert_eq!(queue[2].id, "3");
}

// ===== Three-Tier Queue Persistence Tests =====

#[tokio::test]
async fn test_save_and_load_three_tier_queue() {
    let mut manager = PlaybackManager::default();

    // Set up all three queue tiers
    manager.load_playlist(
        vec![
            create_track("s1", "Source 1", "Artist A", 180),
            create_track("s2", "Source 2", "Artist B", 180),
            create_track("s3", "Source 3", "Artist C", 180),
        ],
        0,
    );

    manager.add_to_queue_next(create_track("n1", "Next 1", "Artist D", 180));
    manager.add_to_queue_next(create_track("n2", "Next 2", "Artist E", 180));

    manager.add_to_queue_end(create_track("q1", "Queue 1", "Artist F", 180));
    manager.add_to_queue_end(create_track("q2", "Queue 2", "Artist G", 180));

    // Serialize
    let json = manager
        .to_persistence_json()
        .expect("Should serialize three-tier queue");

    // Restore
    let mut manager2 = PlaybackManager::default();
    manager2
        .from_persistence_json(&json)
        .expect("Should deserialize three-tier queue");

    let queue = manager2.get_queue();
    let ids: Vec<String> = queue.iter().map(|t| t.id.clone()).collect();

    // Verify priority order: Play Next (LIFO: n2, n1) → Source (s1, s2, s3) → Add to Queue (q1, q2)
    assert_eq!(
        ids,
        vec!["n2", "n1", "s1", "s2", "s3", "q1", "q2"],
        "Restored queue should preserve three-tier structure and priority"
    );
}

#[tokio::test]
async fn test_persist_play_next_queue_only() {
    let mut manager = PlaybackManager::default();

    // Only Play Next queue
    manager.add_to_queue_next(create_track("n1", "Next 1", "Artist A", 180));
    manager.add_to_queue_next(create_track("n2", "Next 2", "Artist B", 180));

    let json = manager.to_persistence_json().expect("Should serialize");

    let mut manager2 = PlaybackManager::default();
    manager2.from_persistence_json(&json).expect("Should deserialize");

    let queue = manager2.get_queue();
    let ids: Vec<String> = queue.iter().map(|t| t.id.clone()).collect();

    assert_eq!(ids, vec!["n2", "n1"], "Play Next queue should be LIFO");
}

#[tokio::test]
async fn test_persist_add_to_queue_only() {
    let mut manager = PlaybackManager::default();

    // Only Add to Queue
    manager.add_to_queue_end(create_track("q1", "Queue 1", "Artist A", 180));
    manager.add_to_queue_end(create_track("q2", "Queue 2", "Artist B", 180));

    let json = manager.to_persistence_json().expect("Should serialize");

    let mut manager2 = PlaybackManager::default();
    manager2.from_persistence_json(&json).expect("Should deserialize");

    let queue = manager2.get_queue();
    let ids: Vec<String> = queue.iter().map(|t| t.id.clone()).collect();

    assert_eq!(ids, vec!["q1", "q2"], "Add to Queue should be FIFO");
}

// ===== Shuffle State Persistence Tests =====

#[tokio::test]
async fn test_persist_shuffle_mode_off() {
    let mut manager = PlaybackManager::default();
    manager.set_shuffle(ShuffleMode::Off);

    manager.load_playlist(
        vec![
            create_track("1", "Track 1", "Artist A", 180),
            create_track("2", "Track 2", "Artist B", 180),
        ],
        0,
    );

    let json = manager.to_persistence_json().expect("Should serialize");

    let mut manager2 = PlaybackManager::default();
    manager2.from_persistence_json(&json).expect("Should deserialize");

    assert_eq!(
        manager2.get_shuffle_mode(),
        ShuffleMode::Off,
        "Shuffle mode should be restored"
    );
}

