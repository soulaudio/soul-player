#[tokio::test]
async fn test_restore_preserves_shuffle_state_and_original_order() {
    let mut manager = PlaybackManager::default();

    let tracks = vec![
        create_track("1", "Track 1", "Artist A", 180),
        create_track("2", "Track 2", "Artist B", 180),
        create_track("3", "Track 3", "Artist C", 180),
        create_track("4", "Track 4", "Artist D", 180),
    ];

    let original_order: Vec<String> = tracks.iter().map(|t| t.id.clone()).collect();

    manager.load_playlist(tracks, 0);
    manager.set_shuffle(ShuffleMode::Random);

    let shuffled_order: Vec<String> = manager.get_queue().iter().map(|t| t.id.clone()).collect();

    // Serialize shuffled state
    let json = manager.to_persistence_json().expect("Should serialize");

    // Restore
    let mut manager2 = PlaybackManager::default();
    manager2.from_persistence_json(&json).expect("Should deserialize");

    // Should restore shuffled order
    let restored_shuffled: Vec<String> = manager2
        .get_queue()
        .iter()
        .map(|t| t.id.clone())
        .collect();
    assert_eq!(
        restored_shuffled, shuffled_order,
        "Restored queue should have same shuffled order"
    );

    // Disable shuffle - should restore original order
    manager2.set_shuffle(ShuffleMode::Off);

    let restored_original: Vec<String> = manager2
        .get_queue()
        .iter()
        .map(|t| t.id.clone())
        .collect();
    assert_eq!(
        restored_original, original_order,
        "Restored queue should preserve original order for unshuffle"
    );
}

