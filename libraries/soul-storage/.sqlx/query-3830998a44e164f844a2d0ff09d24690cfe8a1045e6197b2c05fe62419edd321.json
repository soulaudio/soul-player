  "query": "\n        SELECT track_id, source_id, status, local_file_path, server_path, local_file_size\n        FROM track_sources\n        WHERE track_id IN (\n            SELECT t.id\n            FROM tracks t\n            WHERE (? IS NULL OR t.id > ?)\n            ORDER BY t.id\n            LIMIT ?\n        )\n        ",
