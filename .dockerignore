# Build artifacts
target/
node_modules/
dist/
build/

# Development files
.git/
.github/
.vscode/
.idea/

# Temporary files
*.tmp
.tmp/
*.log

# Environment files (will be set via docker-compose)
.env*
!.env.example
!.env.server

# Documentation
docs/
*.md
!README.md

# Test files
**/*_test.rs
**/tests/

# Database files (will be in volumes)
*.db
*.db-shm
*.db-wal

# OS files
.DS_Store
Thumbs.db

# Moon/CI files
.moon/

# Frontend applications (server doesn't need full source, but needs package.json for Yarn workspace)
applications/desktop/*
!applications/desktop/package.json
!applications/desktop/src-tauri/
applications/desktop/src-tauri/*
!applications/desktop/src-tauri/Cargo.toml

applications/mobile/*
!applications/mobile/package.json

applications/marketing/*
!applications/marketing/package.json

# NOTE: applications/shared/ IS needed - it's used by applications/web/
# NOTE: applications/web/ IS needed - it's bundled with the server for the web UI

# NOTE: .sqlx/ is REQUIRED for CI compilation (SQLx offline mode)
# DO NOT exclude .sqlx/ - it's needed for compile-time query verification
