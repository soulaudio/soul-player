# Soul Player Web Client - Environment Configuration

# API Base URL (where the Soul Player server is running)
# Development: Proxied to localhost:8080 via Vite
# Production: Leave blank to use same origin as web client
VITE_API_URL=

# Example production configurations:
# VITE_API_URL=https://music.example.com/api
# VITE_API_URL=http://localhost:8080/api

# WebSocket URL (for real-time sync, future feature)
VITE_WS_URL=
