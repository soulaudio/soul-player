# Soul Player E2E Test Configuration
# Copy this file to .env and adjust values as needed

# Test Database
# Leave empty to use default test database location
TEST_DB_PATH=

# Test User ID (desktop always uses 1)
TEST_USER_ID=1

# Test Audio Settings
TEST_AUDIO_VOLUME=0.5
TEST_AUDIO_SAMPLE_RATE=48000
TEST_AUDIO_BUFFER_SIZE=2048

# Test Timeouts (milliseconds)
TEST_STARTUP_TIMEOUT=30000
TEST_ELEMENT_TIMEOUT=10000
TEST_NAVIGATION_TIMEOUT=5000

# WebDriver Configuration
WEBDRIVER_LOG_LEVEL=info
WEBDRIVER_PORT=4444

# Test Data
# Number of test tracks to seed for lazy queue tests
TEST_TRACK_COUNT=500

# Screenshot on Failure
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_DIR=./screenshots

# Headless Mode (CI)
HEADLESS=false

# Test Audio Files Path
# Path to directory with test audio files
TEST_AUDIO_PATH=../../tests/fixtures/audio
