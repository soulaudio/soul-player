<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Audio playback (required for audio output) -->
    <key>com.apple.security.device.audio-input</key>
    <false/>

    <!-- Network access (for future server/sync features) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File system access (read audio files) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Bookmark access (remember file locations) -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- Allow JIT for performance (WebView) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required for some audio processing) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation (allow loading of native libraries) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
