{
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: artwork: asset:; media-src 'self' data:; script-src 'self' 'wasm-unsafe-eval';"
    },
    "windows": [
      {
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "fullscreen": false,
        "height": 400,
        "label": "splash",
        "resizable": false,
        "skipTaskbar": true,
        "title": "Soul Player",
        "transparent": true,
        "url": "splash.html",
        "visible": true,
        "width": 600
      },
      {
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "fullscreen": false,
        "height": 800,
        "label": "main",
        "minHeight": 600,
        "minWidth": 800,
        "resizable": true,
        "title": "Soul Player",
        "transparent": false,
        "visible": false,
        "width": 1200
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "yarn build",
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "description": "MP3 Audio File",
        "ext": [
          "mp3"
        ],
        "mimeType": "audio/mpeg",
        "rank": "Owner"
      },
      {
        "description": "FLAC Audio File",
        "ext": [
          "flac"
        ],
        "mimeType": "audio/flac",
        "rank": "Owner"
      },
      {
        "description": "WAV Audio File",
        "ext": [
          "wav"
        ],
        "mimeType": "audio/wav",
        "rank": "Default"
      },
      {
        "description": "OGG Audio File",
        "ext": [
          "ogg",
          "oga"
        ],
        "mimeType": "audio/ogg",
        "rank": "Default"
      },
      {
        "description": "M4A/AAC Audio File",
        "ext": [
          "m4a",
          "mp4",
          "aac"
        ],
        "mimeType": "audio/mp4",
        "rank": "Default"
      },
      {
        "description": "Opus Audio File",
        "ext": [
          "opus"
        ],
        "mimeType": "audio/opus",
        "rank": "Default"
      },
      {
        "description": "Windows Media Audio File",
        "ext": [
          "wma"
        ],
        "mimeType": "audio/x-ms-wma",
        "rank": "Alternate"
      },
      {
        "description": "AIFF Audio File",
        "ext": [
          "aiff",
          "aif"
        ],
        "mimeType": "audio/aiff",
        "rank": "Alternate"
      },
      {
        "description": "Monkey's Audio File",
        "ext": [
          "ape"
        ],
        "mimeType": "audio/x-ape",
        "rank": "Alternate"
      },
      {
        "description": "WavPack Audio File",
        "ext": [
          "wv"
        ],
        "mimeType": "audio/x-wavpack",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "targets": "all",
    "windows": {
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Soul Player"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "identifier": "soul-player",
  "mainBinaryName": "soul-player",
  "plugins": {
    "deepLink": {
      "schemes": [
        "soul"
      ]
    },
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/soulaudio/soul-player/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDRjgyNzhGMjA2NzU5MkUKUldRdVdXY2dqeWY0L0I4V2FpUzlZZEVGMnBFblVGZEZTS1I1blJ3WUx3emVaWmtCUzFQUkxLdGEK"
    }
  },
  "productName": "Soul Player",
  "version": "0.1.15"
}
